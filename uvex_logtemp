# @return none
#
# This function is called by the scheduler.
# -----------------------------------------------------------------------------
def logpress():

    print( time.ctime(), "(logpress) starting" )

    # create log file and needed paths if necessary
    save_path = project_path + "/" + YEAR + "/" + datetime.now().strftime("%Y%m%d")
    logfile = save_path + "/press.csv"
    if not check_files( logfile ):
        print( time.ctime(), "(logpress) ERROR setting up file structure" )
        return

    retryCount = 0
    while retryCount < MAX_RETRIES:        # keep trying until not busy, or give up on error, until MAX_RETRIES
        print( time.ctime(), "(logpress) calling get_press(%s, %s)" % ( press_host, press_port ) )
        press = get_press( press_host, press_port )
#       press = get_edwards( press_host, press_port )
        print( time.ctime(), "(logpress) press=", press )
        if press == None:
            # no attempt to log nor try again on error
            break
        if press == 'ERR':
            # no attempt to log nor try again on error
            break
        if press != 'BSY':
            try:
                if not os.path.exists(logfile):
                    write_press_header = True
                else:
                    write_press_header = False

                pressfile = open(logfile, 'a')

                if write_press_header:
                    pressfile.write( 'datetime, press\n' )

                pressfile.write( '{:}, {:.8f}\n'.format(*press) )
                pressfile.close()
                break

            except Exception as e:
                print( time.ctime(), "(logpress) exception:", str(e) )
                pressfile.close()
                return

        # wait some random period between RND0 and RND1 sec before trying again
        retrytime = uniform(RND0,RND1)
        retryCount += 1
        if retryCount < MAX_RETRIES:
            print( time.ctime(), "(logpress) attempt # %d failed, trying again in %.2f seconds" % (retryCount, retrytime) )
            time.sleep(retrytime)

        if ( retryCount == MAX_RETRIES ) and ( lkstemps == 'BSY' ):
            print( time.ctime(), "(logpress) attempt # %d failed. max retries reached, giving up!" % retryCount )
            return

    print( time.ctime(), "(logpress) exiting" )

    return


