    while retryCount < MAX_RETRIES:        # keep trying until not busy, or give up on error, until MAX_RETRIES
        print( time.ctime(), "(logtemp) calling get_temps(%s, %s, %s, %s)" % ( temp_host, temp_port, temp_channels, heater_channels ) )
