#!/bin/bash
# @file     make_index
# @brief    create index.html file for one or more projects
# @author   David Hale
# @date     2021-01-06
# @modified 2026-09-16 - loop over PROJECT_NAMES read from a "project_names" file
#
# This appends non-existent entries to the index.html file,
# creating the file if it doesn't exist. It also creates
# the symlink to dygraph for web plotting.
#
# Project names are read from an ASCII file called "project_names",
# one project name per line. Blank lines and lines starting with "#"
# are ignored. By default that file is expected to live in the same
# directory as this script -- edit PROJECT_NAMES_FILE below if it
# lives somewhere else (e.g. a fixed path alongside PUBLIC_HTML).

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PROJECT_NAMES_FILE="$SCRIPT_DIR/project_names"
PUBLIC_HTML="/disk/bifrost/uvexdet/data/logs/lakeshore"  # Top level, holds all projects

if [ ! -e "$PROJECT_NAMES_FILE" ]
then
  echo "Project names file not found: $PROJECT_NAMES_FILE"
  exit 1
fi

# Loop over every project name in the file. "|| [ -n "$PROJECT_NAME" ]"
# makes sure the last line is processed even if the file has no
# trailing newline.
while IFS= read -r PROJECT_NAME || [ -n "$PROJECT_NAME" ]
do
  # skip blank lines and comment lines
  [ -z "$PROJECT_NAME" ] && continue
  case "$PROJECT_NAME" in
    \#*) continue ;;
  esac

  echo "=== Processing project: $PROJECT_NAME ==="

  YEARDATE=`date +%Y%m%d`
  YEAR=`date +%Y`
  PROJECT_PATH=$PUBLIC_HTML"/"$PROJECT_NAME
  SAVE_PATH=$PROJECT_PATH"/"$YEAR
  INDEX_HTML=$SAVE_PATH"/index.html"
  DYGRAPH_PUBLIC="../../../dygraph-combined.js"
  #DYGRAPH_PUBLIC=$PUBLIC_HTML"/dygraph-combined.js"
  DYGRAPH_SYMLINK=$SAVE_PATH"/"$YEARDATE"/dygraph-combined.js"

  # it's a new year...
  if [ ! -e $SAVE_PATH ]
  then
    mkdir -p $SAVE_PATH
  fi

  # if data directories don't exist then wait a minute and try again,
  # up to 10 times before giving up on this project
  for RETRY in {1..10}
  do
    if [ ! -e $SAVE_PATH"/"$YEARDATE ]
    then
      echo $SAVE_PATH"/"$YEARDATE" doesn't exist, sleeping 60 sec"
      sleep 60
    else
      break
    fi
  done
  if [ $RETRY == 10 ]
  then
    echo "Exceeded retries waiting for "$SAVE_PATH"/"$YEARDATE" -- giving up on project "$PROJECT_NAME
    continue
  fi

  # create symlinks to dygraph if needed
  if [ ! -e $DYGRAPH_SYMLINK ]
  then
    echo "creating symlinks"
    ln -s $DYGRAPH_PUBLIC $DYGRAPH_SYMLINK
  fi

  # html preamble (create file if needed)
  if [ ! -e $INDEX_HTML ]
  then
    echo "<!-- This file is automatically generated !-->" > $INDEX_HTML
    echo "<!-- Any manual edits will be lost        !-->" >> $INDEX_HTML
    echo "" >> $INDEX_HTML
    echo "<html>" >> $INDEX_HTML
    echo "<head>" >> $INDEX_HTML
    echo "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">" >> $INDEX_HTML
    echo "<style type="text/css">" >> $INDEX_HTML
    echo "</style>" >> $INDEX_HTML
    echo "</head>" >> $INDEX_HTML
    echo "<h3>CMOST data logs "$YEAR"</h3>" >> $INDEX_HTML
    echo "" >> $INDEX_HTML
  fi

  FIRSTTIME=1

  # Loop through every entry, extract the YYYY, MM, DD
  # and create the html links for each.
  for i in $SAVE_PATH/$YEAR????
    do
      YEARDATE=`echo $i | awk -F"$YEAR/" '{print $2}'`   # YYYYMMDD (today)
      DATE=`echo $YEARDATE | awk -F"$YEAR" '{print $2}'` # MMDD
      MM=`echo $DATE | awk '{print substr($1,1,2)}'`     # MM
      DD=`echo $DATE | awk '{print substr($1,3,4)}'`     # DD

      # If today isn't in the index.html file then add entry for it (and previous two days).
      cd $SAVE_PATH/$YEARDATE/
      if ! grep --quiet $YEARDATE $INDEX_HTML
      then

        # If this is a new month then insert a line break (looks better).
        # This "firsttime" business makes sure that LASTMONTH is defined.

        if [ $FIRSTTIME -eq 1 ]
        then

          # the 11th line from the INDEX_HTML file is the last line written
          LASTLINE=`sed '11q;d' $INDEX_HTML`
          #extract the month from that last line
          LASTMONTH=`echo $LASTLINE | awk -F"$YEAR" '{print substr ($2, 0, 2)}'`
          FIRSTTIME=0
        fi

        if [ "$LASTMONTH" != "$MM" ]
        then
          sed -i "11i <br>" $INDEX_HTML
          FIRSTTIME=0
        fi

        # Insert new line at line 11 (first 9 lines are preamble).
        # This ensures the newest line is at the top.
        sed -i "11i <a href=\"$YEARDATE\">$YEAR-$MM-$DD</a> <br>" $INDEX_HTML

        # Create symlinks from each dated file to a generically named file,
        # for reading by index.html file.
        if [ ! -e temps.csv ];       then ln -s temps.$YEARDATE.csv       temps.csv;       fi
      fi

      # last month inserted into .index file
      LASTMONTH=$MM
    done

done < "$PROJECT_NAMES_FILE"  # File is fed into the while IFS=... loop here

